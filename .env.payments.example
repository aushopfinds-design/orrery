# Preview/development only. Never put these values in VITE_* variables or commit filled copies.
FATE_PAYMENTS_MODE=test
FATE_PAYMENTS_ORIGIN=
FATE_PAYMENTS_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FATE_ORDER_DATA_KEY=
FATE_ORDER_ACCESS_KEY=
FATE_CHECKOUT_TEST_TOKEN=
# DATA_KEY and ACCESS_KEY: separate cryptographically random 32-byte keys in hex.
# DATABASE_URL: pooled connection, sslmode=verify-full. Migration uses the direct connection.
# Live keys and VERCEL_ENV=production are rejected by this stage-one implementation.
