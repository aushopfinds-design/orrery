# Production only. Keep Preview credentials and its database separate.
# Leave checkout closed until operator information, policies, tax setup,
# Stripe onboarding and an approved launch decision have been checked.
FATE_PAYMENTS_MODE=live
FATE_CHECKOUT_OPEN=false
FATE_SALES_POLICIES_READY=false
FATE_PUBLIC_OPERATOR_NAME=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
FATE_PAYMENTS_LIVE_DATABASE_URL=
FATE_LIVE_ORDER_DATA_KEY=
FATE_LIVE_ORDER_ACCESS_KEY=
# DATA/ACCESS keys: independent cryptographically random 32-byte hex values.
# Database URL requires sslmode=verify-full. Use a new live database and
# initialize it using server/payments/live-schema.sql, never a Preview DB.
# Stripe webhook: https://thefatekey.com/api/payments?action=webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, charge.refunded.
# Turning FATE_CHECKOUT_OPEN off stops new orders without disabling existing
# purchase recovery, report/PDF access or payment webhooks.

# Enable only after 003_customer_records.sql is approved and applied.
FATE_CUSTOMER_RECORDS_ENABLED=false
