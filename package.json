{
  "name": "orrery",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun run --cwd packages/core build && tsc -b && vite build && node scripts/build-public-pages.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-icons": "bun scripts/generate-icons.ts",
    "generate-og-image": "bun scripts/generate-og-image.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@orrery/core": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "@photostructure/tz-lookup": "^11.2.0",
    "@vercel/functions": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
