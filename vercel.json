{
  "functions": {
    "api/admin-review.ts": {
      "maxDuration": 90
    },
    "api/payments.ts": {
      "includeFiles": "{server/payments/assets/**,public/images/cards/destiny-background-v2.webp,public/images/cards/destiny-key-v2.png}",
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
