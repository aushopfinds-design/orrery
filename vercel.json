{
  "functions": {
    "api/admin-review.ts": {
      "includeFiles": "{docs/quality-audits/35-pdf-content-extraction-2026-11-11.json,docs/quality-audits/product-03-preliminary-review-2026-11-11.json,docs/quality-audits/current-pdf-quality-evaluation-2026-11-11.json}",
      "maxDuration": 90
    },
    "api/payments.ts": {
      "includeFiles": "{server/payments/assets/**,public/images/cards/destiny-background-v2.webp,public/images/cards/destiny-key-v2.png}",
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/admin/quality", "destination": "/api/admin-review?view=quality" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
